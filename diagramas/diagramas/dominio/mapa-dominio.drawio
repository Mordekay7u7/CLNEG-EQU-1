  <diagram id="MNV-dominio03" name="03 · Políticas de reserva y asistencia">
    <mxGraphModel dx="1622" dy="895" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3652" pageHeight="1881" math="0" shadow="0">
