          <mxGeometry height="1586" width="896" x="2722" y="225" as="geometry" />
        </mxCell>
        <mxCell id="n_solicitud" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E9D8FD;strokeWidth=2.6;align=left;verticalAlign=top;spacing=0;overflow=fill;fontColor=#43365F;fontSize=14;" value="&lt;div style=&quot;background:#E9D8FD;color:#43365F;font-size:21px;font-weight:bold;padding:14px&quot;&gt;Solicitud de reserva&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:9px;font-size:15px;line-height:1.6&quot;&gt;• Datos: paciente, médico, sede, intervalo&lt;br/&gt;• Validar identidad y datos obligatorios&lt;br/&gt;• Consultar disponibilidad de la jornada&lt;br/&gt;• Rechazar si el intervalo es inválido&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="499" x="617" y="564" as="geometry" />
        </mxCell>
        <mxCell id="header_band" parent="1" style="rounded=0;fillColor=#F3ECFF;strokeColor=none;locked=1;" value="" vertex="1">
