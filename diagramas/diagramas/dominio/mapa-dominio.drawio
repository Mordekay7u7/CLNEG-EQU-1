        <mxCell id="e1" edge="1" parent="1" source="n_colision" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#8062C8;strokeWidth=2.2;fontColor=#5A478D;fontSize=13;labelBackgroundColor=#FCFAFF;" target="n_retencion" value="si disponible">
