          <mxGeometry height="11" width="2644" as="geometry" />
        </mxCell>
        <mxCell id="header_kicker" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#625082;" value="MEDINOVA  /  ARQUITECTURA DE SOFTWARE&amp;nbsp;" vertex="1">
          <mxGeometry height="38" width="2504" x="90" y="34" as="geometry" />
        </mxCell>
        <mxCell id="header_title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=38;fontStyle=1;fontColor=#352956;" value="01  |  Mapa estratégico de contextos" vertex="1">
          <mxGeometry height="70" width="2504" x="88" y="72" as="geometry" />
        </mxCell>
        <mxCell id="n_jornada" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DCE8FF;strokeWidth=2.6;align=left;verticalAlign=top;spacing=0;overflow=fill;fontColor=#43365F;fontSize=14;" value="&lt;div style=&quot;background:#DCE8FF;color:#43365F;font-size:21px;font-weight:bold;padding:14px&quot;&gt;Agenda médica&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:9px;font-size:15px;line-height:1.6&quot;&gt;• Responsabilidad: disponibilidad por médico y sede&lt;br/&gt;• Modelo: JornadaMedica, Turno, Sobrecupo&lt;br/&gt;• Reglas: aval médico; máximo 2 extras/turno&lt;br/&gt;• Expone: consultarDisponibilidad()&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="499" x="1090" y="310" as="geometry" />
        </mxCell>
        <mxCell id="n_paciente" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FBD8EF;strokeWidth=2.6;align=left;verticalAlign=top;spacing=0;overflow=fill;fontColor=#43365F;fontSize=14;" value="&lt;div style=&quot;background:#FBD8EF;color:#43365F;font-size:21px;font-weight:bold;padding:14px&quot;&gt;Pacientes e historial&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:9px;font-size:15px;line-height:1.6&quot;&gt;• Responsabilidad: expediente e historial&lt;br/&gt;• Modelo: ExpedientePaciente, NoShow&lt;br/&gt;• Reglas: registro de ausencias y reincidencia&lt;br/&gt;• Expone: obtenerHistorial()&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="499" x="1230" y="590" as="geometry" />
        </mxCell>
        <mxCell id="n_asistencia" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CFF5EB;strokeWidth=2.6;align=left;verticalAlign=top;spacing=0;overflow=fill;fontColor=#43365F;fontSize=14;" value="&lt;div style=&quot;background:#CFF5EB;color:#43365F;font-size:21px;font-weight:bold;padding:14px&quot;&gt;Recepción y asistencia&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:9px;font-size:15px;line-height:1.6&quot;&gt;• Responsabilidad: registrar llegada real&lt;br/&gt;• Reglas: tolerancia 15 min con decisión médica&lt;br/&gt;• No-show: 20 min sin registro de llegada&lt;br/&gt;• Emite: LlegadaRegistrada, NoShowRegistrado&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="499" x="1110" y="995" as="geometry" />
        </mxCell>
        <mxCell id="n_cobertura" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D8F3FA;strokeWidth=2.6;align=left;verticalAlign=top;spacing=0;overflow=fill;fontColor=#43365F;fontSize=14;" value="&lt;div style=&quot;background:#D8F3FA;color:#43365F;font-size:21px;font-weight:bold;padding:14px&quot;&gt;Cobertura de aseguradoras&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:9px;font-size:15px;line-height:1.6&quot;&gt;• Responsabilidad: validar convenio y cobertura&lt;br/&gt;• Integra respuesta de proveedor externo&lt;br/&gt;• Mantiene estado de autorización&lt;br/&gt;• No determina disponibilidad de agenda&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="499" x="1110" y="1263" as="geometry" />
        </mxCell>
        <mxCell id="n_seguimiento" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E9D8FD;strokeWidth=2.6;align=left;verticalAlign=top;spacing=0;overflow=fill;fontColor=#43365F;fontSize=14;" value="&lt;div style=&quot;background:#E9D8FD;color:#43365F;font-size:21px;font-weight:bold;padding:14px&quot;&gt;Seguimiento clínico&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:9px;font-size:15px;line-height:1.6&quot;&gt;• Responsabilidad: acciones posteriores a consulta&lt;br/&gt;• Reagenda y orden de estudio cuando proceda&lt;br/&gt;• Referencia citas y expedientes por ID&lt;br/&gt;• No modifica directamente el agregado Cita&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="499" x="1990" y="995" as="geometry" />
        </mxCell>
        <mxCell id="n_avisos" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFE1E9;strokeWidth=2.6;align=left;verticalAlign=top;spacing=0;overflow=fill;fontColor=#43365F;fontSize=14;" value="&lt;div style=&quot;background:#FFE1E9;color:#43365F;font-size:21px;font-weight:bold;padding:14px&quot;&gt;Comunicaciones&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:9px;font-size:15px;line-height:1.6&quot;&gt;• Responsabilidad: confirmaciones y avisos&lt;br/&gt;• Consume resultados de casos de uso&lt;br/&gt;• Entrega mensajes a canales externos&lt;br/&gt;• No controla reglas de reserva&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="499" x="1110" y="1531" as="geometry" />
        </mxCell>
