        <mxCell id="ribbon_3" parent="1" style="rounded=1;arcSize=3;fillColor=#EDEBFF;opacity=46;strokeColor=none;locked=1;" value="" vertex="1">
          <mxGeometry height="1569" width="632" x="1932" y="225" as="geometry" />
        </mxCell>
        <mxCell id="n_cita" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E9D8FD;strokeWidth=2.6;align=left;verticalAlign=top;spacing=0;overflow=fill;fontColor=#43365F;fontSize=14;" value="&lt;div style=&quot;background:#E9D8FD;color:#43365F;font-size:21px;font-weight:bold;padding:14px&quot;&gt;«AggregateRoot» Cita&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:9px;font-size:15px;line-height:1.6&quot;&gt;• Identidad: CitaId; referencias: PacienteId, MedicoId&lt;br/&gt;• Valor: Horario; estado: EstadoCita&lt;br/&gt;• Invariante: transición válida de estado&lt;br/&gt;• Operaciones: cancelar(), registrarLlegada()&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="499" x="1046" y="960" as="geometry" />
        </mxCell>
        <mxCell id="header_band" parent="1" style="rounded=0;fillColor=#F3ECFF;strokeColor=none;locked=1;" value="" vertex="1">
          <mxGeometry height="187" width="2600" as="geometry" />
        </mxCell>
        <mxCell id="header_rule" parent="1" style="rounded=0;fillColor=#9272DB;strokeColor=none;locked=1;" value="" vertex="1">
          <mxGeometry height="11" width="2600" as="geometry" />
        </mxCell>
        <mxCell id="header_kicker" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#625082;" value="MEDINOVA  /  ARQUITECTURA DE SOFTWARE&amp;nbsp;" vertex="1">
          <mxGeometry height="38" width="2460" x="70" y="43.5" as="geometry" />
        </mxCell>
        <mxCell id="header_title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=38;fontStyle=1;fontColor=#352956;" value="02  |  Agregados y referencias" vertex="1">
          <mxGeometry height="70" width="2460" x="70" y="81.5" as="geometry" />
        </mxCell>
        <mxCell id="n_jornada" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DCE8FF;strokeWidth=2.6;align=left;verticalAlign=top;spacing=0;overflow=fill;fontColor=#43365F;fontSize=14;" value="&lt;div style=&quot;background:#DCE8FF;color:#43365F;font-size:21px;font-weight:bold;padding:14px&quot;&gt;«AggregateRoot» JornadaMedica&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:9px;font-size:15px;line-height:1.6&quot;&gt;• Identidad: JornadaId; sede y médico&lt;br/&gt;• Contiene turnos, disponibilidad y sobrecupos&lt;br/&gt;• Invariante: máximo 2 sobrecupos por turno&lt;br/&gt;• Operaciones: validarCupo(), autorizarExtra()&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="499" x="1020" y="440" as="geometry" />
        </mxCell>
        <mxCell id="n_exp" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FBD8EF;strokeWidth=2.6;align=left;verticalAlign=top;spacing=0;overflow=fill;fontColor=#43365F;fontSize=14;" value="&lt;div style=&quot;background:#FBD8EF;color:#43365F;font-size:21px;font-weight:bold;padding:14px&quot;&gt;«AggregateRoot» ExpedientePaciente&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:9px;font-size:15px;line-height:1.6&quot;&gt;• Identidad: ExpedienteId; referencia PacienteId&lt;br/&gt;• Registra historial y ausencias&lt;br/&gt;• Invariante: una ausencia corresponde a una cita&lt;br/&gt;• Operación: registrarNoShow(citaId)&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="531" x="1870" y="650" as="geometry" />
        </mxCell>
        <mxCell id="n_horario" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D8F3FA;strokeWidth=2.6;align=left;verticalAlign=top;spacing=0;overflow=fill;fontColor=#43365F;fontSize=14;" value="&lt;div style=&quot;background:#D8F3FA;color:#43365F;font-size:21px;font-weight:bold;padding:14px&quot;&gt;«ValueObject» Horario&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:9px;font-size:15px;line-height:1.6&quot;&gt;• fecha: Date; inicio: Time; fin: Time&lt;br/&gt;• Invariante: inicio anterior al fin&lt;br/&gt;• Operación: solapa(otro): bool&lt;br/&gt;• Comparación por valores&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="499" x="1870" y="1320" as="geometry" />
        </mxCell>
        <mxCell id="n_estado" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFE1E9;strokeWidth=2.6;align=left;verticalAlign=top;spacing=0;overflow=fill;fontColor=#43365F;fontSize=14;" value="&lt;div style=&quot;background:#FFE1E9;color:#43365F;font-size:21px;font-weight:bold;padding:14px&quot;&gt;«Enumeration» EstadoCita&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:9px;font-size:15px;line-height:1.6&quot;&gt;• RESERVADA / CANCELADA / NO_SHOW&lt;br/&gt;• Transiciones controladas por Cita&lt;br/&gt;• No se actualiza desde repositorios externos&lt;br/&gt;• Cambios trazados con autor y momento&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="499" x="910" y="1470" as="geometry" />
        </mxCell>
        <mxCell id="n_policy" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CFF5EB;strokeWidth=2.6;align=left;verticalAlign=top;spacing=0;overflow=fill;fontColor=#43365F;fontSize=14;" value="&lt;div style=&quot;background:#CFF5EB;color:#43365F;font-size:21px;font-weight:bold;padding:14px&quot;&gt;«DomainService» PoliticaReserva&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:9px;font-size:15px;line-height:1.6&quot;&gt;• Verifica colisión entre sucursales&lt;br/&gt;• Exige bloqueo vigente de 3 minutos&lt;br/&gt;• Evalúa permisos para sobrecupo&lt;br/&gt;• Coordina reglas, no persiste datos&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="499" x="200" y="960" as="geometry" />
        </mxCell>
        <mxCell id="n_ref" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E9D8FD;strokeWidth=2.6;align=left;verticalAlign=top;spacing=0;overflow=fill;fontColor=#43365F;fontSize=14;" value="&lt;div style=&quot;background:#E9D8FD;color:#43365F;font-size:21px;font-weight:bold;padding:14px&quot;&gt;Referencias entre agregados&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:9px;font-size:15px;line-height:1.6&quot;&gt;• Cita → JornadaMedica: JornadaId&lt;br/&gt;• Cita → ExpedientePaciente: ExpedienteId&lt;br/&gt;• No compartir objetos internos mutables&lt;br/&gt;• Consistencia local en cada raíz&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="499" x="240" y="420" as="geometry" />
        </mxCell>
        <mxCell id="e0" edge="1" parent="1" source="n_cita" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#8062C8;strokeWidth=2.2;fontColor=#5A478D;fontSize=13;labelBackgroundColor=#FCFAFF;" target="n_horario" value="compone 1">
          <mxGeometry relative="1" x="-0.0058" y="-20" as="geometry">
