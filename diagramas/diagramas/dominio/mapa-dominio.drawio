        <mxCell id="n_jornada" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DCE8FF;strokeWidth=2.6;align=left;verticalAlign=top;spacing=0;overflow=fill;fontColor=#43365F;fontSize=14;" value="&lt;div style=&quot;background:#DCE8FF;color:#43365F;font-size:21px;font-weight:bold;padding:14px&quot;&gt;Cita CANCELADA&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:9px;font-size:15px;line-height:1.6&quot;&gt;• Conserva motivo, actor e instante&lt;br/&gt;• No admite llegada como cita activa&lt;br/&gt;• Estado terminal de reserva&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="499" x="1010" y="260" as="geometry" />
        </mxCell>
