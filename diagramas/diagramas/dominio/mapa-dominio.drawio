        <mxCell id="n_agenda" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E9D8FD;strokeWidth=2.6;align=left;verticalAlign=top;spacing=0;overflow=fill;fontColor=#43365F;fontSize=14;" value="&lt;div style=&quot;background:#E9D8FD;color:#43365F;font-size:21px;font-weight:bold;padding:14px&quot;&gt;Gestión de citas&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:9px;font-size:15px;line-height:1.6&quot;&gt;• Responsabilidad: reservar, cancelar y reprogramar&lt;br/&gt;• Modelo: Cita, EstadoCita, Horario&lt;br/&gt;• Reglas: colisión entre sedes; bloqueo de 3 min&lt;br/&gt;• Publica: CitaReservada, CitaCancelada&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="499" x="231" y="995" as="geometry" />
        </mxCell>
        <mxCell id="header_band" parent="1" style="rounded=0;fillColor=#F3ECFF;strokeColor=none;locked=1;" value="" vertex="1">
          <mxGeometry height="187" width="2644" as="geometry" />
