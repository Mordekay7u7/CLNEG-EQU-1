        <mxCell id="n_asistencia" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CFF5EB;strokeWidth=2.6;align=left;verticalAlign=top;spacing=0;overflow=fill;fontColor=#43365F;fontSize=14;" value="&lt;div style=&quot;background:#CFF5EB;color:#43365F;font-size:21px;font-weight:bold;padding:14px&quot;&gt;«Entity» Turno&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:9px;font-size:15px;line-height:1.6&quot;&gt;• TurnoId dentro de una jornada&lt;br/&gt;• Intervalo, cupo y ocupación&lt;br/&gt;• No se modifica desde otro agregado&lt;/div&gt;" vertex="1">
