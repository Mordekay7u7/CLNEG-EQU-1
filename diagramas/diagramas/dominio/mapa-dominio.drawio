        <mxCell id="n_jornada" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DCE8FF;strokeWidth=2.6;align=left;verticalAlign=top;spacing=0;overflow=fill;fontColor=#43365F;fontSize=14;" value="&lt;div style=&quot;background:#DCE8FF;color:#43365F;font-size:21px;font-weight:bold;padding:14px&quot;&gt;Colisión entre sedes&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:9px;font-size:15px;line-height:1.6&quot;&gt;• Compara citas activas del mismo paciente&lt;br/&gt;• Evalúa las tres sucursales&lt;br/&gt;• Rechaza intervalos solapados&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="499" x="1170" y="600" as="geometry" />
        </mxCell>
        <mxCell id="n_paciente" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FBD8EF;strokeWidth=2.6;align=left;verticalAlign=top;spacing=0;overflow=fill;fontColor=#43365F;fontSize=14;" value="&lt;div style=&quot;background:#FBD8EF;color:#43365F;font-size:21px;font-weight:bold;padding:14px&quot;&gt;Retención temporal&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:9px;font-size:15px;line-height:1.6&quot;&gt;• Bloqueo máximo de tres minutos&lt;br/&gt;• Libera al vencer o abandonar&lt;br/&gt;• No equivale a reserva confirmada&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="499" x="1720" y="350" as="geometry" />
        </mxCell>
        <mxCell id="n_asistencia" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CFF5EB;strokeWidth=2.6;align=left;verticalAlign=top;spacing=0;overflow=fill;fontColor=#43365F;fontSize=14;" value="&lt;div style=&quot;background:#CFF5EB;color:#43365F;font-size:21px;font-weight:bold;padding:14px&quot;&gt;Sobrecupo autorizado&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:9px;font-size:15px;line-height:1.6&quot;&gt;• Solo con habilitación del médico&lt;br/&gt;• Máximo dos adicionales por turno&lt;br/&gt;• Conserva autor y autorización&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="499" x="1970" y="840" as="geometry" />
        </mxCell>
        <mxCell id="n_cobertura" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D8F3FA;strokeWidth=2.6;align=left;verticalAlign=top;spacing=0;overflow=fill;fontColor=#43365F;fontSize=14;" value="&lt;div style=&quot;background:#D8F3FA;color:#43365F;font-size:21px;font-weight:bold;padding:14px&quot;&gt;Concurrencia&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:9px;font-size:15px;line-height:1.6&quot;&gt;• Control de versión al persistir&lt;br/&gt;• Impide sobreasignación simultánea&lt;br/&gt;• No deja cambios parciales&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="499" x="730" y="1070" as="geometry" />
        </mxCell>
        <mxCell id="n_seguimiento" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E9D8FD;strokeWidth=2.6;align=left;verticalAlign=top;spacing=0;overflow=fill;fontColor=#43365F;fontSize=14;" value="&lt;div style=&quot;background:#E9D8FD;color:#43365F;font-size:21px;font-weight:bold;padding:14px&quot;&gt;Llegada y ausencia&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:9px;font-size:15px;line-height:1.6&quot;&gt;• Hora real registrada en recepción&lt;br/&gt;• Decisión médica para retraso hasta 15 min&lt;br/&gt;• No-show tras 20 min sin llegada&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="499" x="2000" y="1220" as="geometry" />
        </mxCell>
        <mxCell id="n_avisos" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFE1E9;strokeWidth=2.6;align=left;verticalAlign=top;spacing=0;overflow=fill;fontColor=#43365F;fontSize=14;" value="&lt;div style=&quot;background:#FFE1E9;color:#43365F;font-size:21px;font-weight:bold;padding:14px&quot;&gt;Cobertura externa&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:9px;font-size:15px;line-height:1.6&quot;&gt;• Rechazo distinto de timeout&lt;br/&gt;• No modifica automáticamente la agenda&lt;br/&gt;• Registra resultado sin inventar aprobación&lt;/div&gt;" vertex="1">
