          <mxGeometry height="210" width="499" x="1900" y="450" as="geometry" />
        </mxCell>
        <mxCell id="n_asistencia" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CFF5EB;strokeWidth=2.6;align=left;verticalAlign=top;spacing=0;overflow=fill;fontColor=#43365F;fontSize=14;" value="&lt;div style=&quot;background:#CFF5EB;color:#43365F;font-size:21px;font-weight:bold;padding:14px&quot;&gt;Evaluación de retraso&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:9px;font-size:15px;line-height:1.6&quot;&gt;• Compara hora real con cita&lt;br/&gt;• Hasta 15 min: consulta al médico&lt;br/&gt;• No supone aceptación automática&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="499" x="1440" y="920" as="geometry" />
        </mxCell>
        <mxCell id="n_cobertura" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D8F3FA;strokeWidth=2.6;align=left;verticalAlign=top;spacing=0;overflow=fill;fontColor=#43365F;fontSize=14;" value="&lt;div style=&quot;background:#D8F3FA;color:#43365F;font-size:21px;font-weight:bold;padding:14px&quot;&gt;NO_SHOW&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:9px;font-size:15px;line-height:1.6&quot;&gt;• Tras 20 min sin llegada válida&lt;br/&gt;• No procede en cita cancelada&lt;br/&gt;• Se refleja una vez en historial&lt;/div&gt;" vertex="1">
