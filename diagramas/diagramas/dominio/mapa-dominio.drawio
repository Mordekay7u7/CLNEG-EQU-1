        <mxCell id="n_jornada" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DCE8FF;strokeWidth=2.6;align=left;verticalAlign=top;spacing=0;overflow=fill;fontColor=#43365F;fontSize=14;" value="&lt;div style=&quot;background:#DCE8FF;color:#43365F;font-size:21px;font-weight:bold;padding:14px&quot;&gt;«AggregateRoot» JornadaMedica&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:9px;font-size:15px;line-height:1.6&quot;&gt;• JornadaId, médico, sede y turnos&lt;br/&gt;• Valida cupo y sobrecupo autorizado&lt;br/&gt;• Controla cambios de Turno&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="499" x="120" y="720" as="geometry" />
        </mxCell>
        <mxCell id="n_paciente" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FBD8EF;strokeWidth=2.6;align=left;verticalAlign=top;spacing=0;overflow=fill;fontColor=#43365F;fontSize=14;" value="&lt;div style=&quot;background:#FBD8EF;color:#43365F;font-size:21px;font-weight:bold;padding:14px&quot;&gt;«AggregateRoot» ExpedientePaciente&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:9px;font-size:15px;line-height:1.6&quot;&gt;• ExpedienteId y referencia PacienteId&lt;br/&gt;• Historial de llegadas y ausencias&lt;br/&gt;• Impide duplicar no-show por cita&lt;/div&gt;" vertex="1">
