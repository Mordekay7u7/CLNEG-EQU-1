        </mxCell>
        <mxCell id="n_reserva" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E9D8FD;strokeWidth=2.6;align=left;verticalAlign=top;spacing=0;overflow=fill;fontColor=#43365F;fontSize=14;" value="&lt;div style=&quot;background:#E9D8FD;color:#43365F;font-size:21px;font-weight:bold;padding:14px&quot;&gt;CitaReservada&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:9px;font-size:15px;line-height:1.6&quot;&gt;• Origen: agregado Cita&lt;br/&gt;• Datos: citaId, pacienteId, médicoId&lt;br/&gt;• Momento: confirmación persistida&lt;br/&gt;• Consumidores: avisos y consultas&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="499" x="1055" y="945" as="geometry" />
        </mxCell>
        <mxCell id="header_band" parent="1" style="rounded=0;fillColor=#F3ECFF;strokeColor=none;locked=1;" value="" vertex="1">
          <mxGeometry height="187" width="2550" as="geometry" />
        </mxCell>
        <mxCell id="header_rule" parent="1" style="rounded=0;fillColor=#9272DB;strokeColor=none;locked=1;" value="" vertex="1">
          <mxGeometry height="11" width="2550" as="geometry" />
        </mxCell>
        <mxCell id="header_kicker" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#625082;" value="MEDINOVA  /  ARQUITECTURA DE SOFTWARE&amp;nbsp;" vertex="1">
          <mxGeometry height="38" width="2410" x="80" y="45" as="geometry" />
        </mxCell>
        <mxCell id="header_title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=38;fontStyle=1;fontColor=#352956;" value="04  |  Asistencia e historial clínico" vertex="1">
          <mxGeometry height="70" width="2410" x="80" y="72" as="geometry" />
        </mxCell>
        <mxCell id="n_cancel" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FBD8EF;strokeWidth=2.6;align=left;verticalAlign=top;spacing=0;overflow=fill;fontColor=#43365F;fontSize=14;" value="&lt;div style=&quot;background:#FBD8EF;color:#43365F;font-size:21px;font-weight:bold;padding:14px&quot;&gt;CitaCancelada&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:9px;font-size:15px;line-height:1.6&quot;&gt;• Origen: agregado Cita&lt;br/&gt;• Datos: citaId, motivo, fecha&lt;br/&gt;• Efecto: libera disponibilidad según política&lt;br/&gt;• Consumidores: agenda y notificaciones&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="499" x="1055" y="410" as="geometry" />
        </mxCell>
        <mxCell id="n_llegada" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CFF5EB;strokeWidth=2.6;align=left;verticalAlign=top;spacing=0;overflow=fill;fontColor=#43365F;fontSize=14;" value="&lt;div style=&quot;background:#CFF5EB;color:#43365F;font-size:21px;font-weight:bold;padding:14px&quot;&gt;LlegadaRegistrada&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:9px;font-size:15px;line-height:1.6&quot;&gt;• Origen: registro de recepción&lt;br/&gt;• Datos: citaId, instante de llegada&lt;br/&gt;• Efecto: impide ausencia automática&lt;br/&gt;• Consumidores: asistencia e historial&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="499" x="231" y="679" as="geometry" />
        </mxCell>
        <mxCell id="n_no" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFE1E9;strokeWidth=2.6;align=left;verticalAlign=top;spacing=0;overflow=fill;fontColor=#43365F;fontSize=14;" value="&lt;div style=&quot;background:#FFE1E9;color:#43365F;font-size:21px;font-weight:bold;padding:14px&quot;&gt;NoShowRegistrado&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:9px;font-size:15px;line-height:1.6&quot;&gt;• Origen: procesamiento de ausencias&lt;br/&gt;• Condición: 20 min sin llegada&lt;br/&gt;• Efecto: actualiza historial y reincidencia&lt;br/&gt;• Consumidores: seguimiento y consultas&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="499" x="1055" y="679" as="geometry" />
        </mxCell>
        <mxCell id="n_jornada" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DCE8FF;strokeWidth=2.6;align=left;verticalAlign=top;spacing=0;overflow=fill;fontColor=#43365F;fontSize=14;" value="&lt;div style=&quot;background:#DCE8FF;color:#43365F;font-size:21px;font-weight:bold;padding:14px&quot;&gt;JornadaModificada&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:9px;font-size:15px;line-height:1.6&quot;&gt;• Origen: agenda del médico&lt;br/&gt;• Datos: médicoId, sedeId, franja afectada&lt;br/&gt;• Efecto: revalidación de disponibilidad&lt;br/&gt;• Consumidores: gestión de citas&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="499" x="231" y="945" as="geometry" />
        </mxCell>
