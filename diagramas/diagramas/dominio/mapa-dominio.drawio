        <mxCell id="n_jornada" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DCE8FF;strokeWidth=2.6;align=left;verticalAlign=top;spacing=0;overflow=fill;fontColor=#43365F;fontSize=14;" value="&lt;div style=&quot;background:#DCE8FF;color:#43365F;font-size:21px;font-weight:bold;padding:14px&quot;&gt;JornadaModificada&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:9px;font-size:15px;line-height:1.6&quot;&gt;• Identifica médico, sede y franja&lt;br/&gt;• Solicita revisión de citas afectadas&lt;br/&gt;• No cancela automáticamente reservas&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="499" x="1140" y="225" as="geometry" />
        </mxCell>
        <mxCell id="n_paciente" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FBD8EF;strokeWidth=2.6;align=left;verticalAlign=top;spacing=0;overflow=fill;fontColor=#43365F;fontSize=14;" value="&lt;div style=&quot;background:#FBD8EF;color:#43365F;font-size:21px;font-weight:bold;padding:14px&quot;&gt;LlegadaRegistrada&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:9px;font-size:15px;line-height:1.6&quot;&gt;• Conserva CitaId y hora real&lt;br/&gt;• Inhibe declaración automática de no-show&lt;br/&gt;• Alimenta historial de asistencia&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="499" x="1950" y="350" as="geometry" />
        </mxCell>
        <mxCell id="n_asistencia" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CFF5EB;strokeWidth=2.6;align=left;verticalAlign=top;spacing=0;overflow=fill;fontColor=#43365F;fontSize=14;" value="&lt;div style=&quot;background:#CFF5EB;color:#43365F;font-size:21px;font-weight:bold;padding:14px&quot;&gt;NoShowRegistrado&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:9px;font-size:15px;line-height:1.6&quot;&gt;• Se valida el umbral de 20 minutos&lt;br/&gt;• Evita eventos duplicados por cita&lt;br/&gt;• Actualiza historial y consultas&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="499" x="1540" y="880" as="geometry" />
        </mxCell>
        <mxCell id="n_cobertura" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D8F3FA;strokeWidth=2.6;align=left;verticalAlign=top;spacing=0;overflow=fill;fontColor=#43365F;fontSize=14;" value="&lt;div style=&quot;background:#D8F3FA;color:#43365F;font-size:21px;font-weight:bold;padding:14px&quot;&gt;CoberturaEvaluada&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:9px;font-size:15px;line-height:1.6&quot;&gt;• Resultado asociado a solicitud&lt;br/&gt;• Autorizada, rechazada o pendiente&lt;br/&gt;• No altera cupo por sí misma&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="499" x="740" y="1280" as="geometry" />
        </mxCell>
